NODE_ENV=development
PORT=3333

# Postgres — bate com o docker-compose.yml
DATABASE_URL="postgresql://zapwave:zapwave@localhost:5432/zapwave?schema=public"

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Front: origens liberadas no CORS e no WebSocket (separadas por vírgula).
# Padrão: http://localhost:3000,http://localhost:5173
# CORS_ORIGINS=http://localhost:3000

# Limite de requisições por IP. Padrão: true (os testes e2e desligam)
# RATE_LIMIT_ENABLED=true

# Auth — par de chaves RSA (RS256) em base64, PEM PKCS8 (private) / SPKI (public).
# Gerar:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
#   Windows (PowerShell): [Convert]::ToBase64String([IO.File]::ReadAllBytes("private.pem"))
#   Linux/macOS:           base64 -w0 private.pem
JWT_PRIVATE_KEY="change-me"
JWT_PUBLIC_KEY="change-me"
